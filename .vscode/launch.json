{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sathya (uses config/app_env.json)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=config/app_env.json"
      ]
    },
    {
      "name": "CMS (Chrome, uses config/app_env.json)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=3001",
        "--dart-define-from-file=config/app_env.json"
      ]
    }
  ]
}
